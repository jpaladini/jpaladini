---
import Analytics from '@vercel/analytics/astro';
import DitherBackground from '../components/DitherBackground.astro';

interface Props {
  title?: string;
  description?: string;
  /** Which page is current, for aria-current on the matching nav item. */
  active?: 'home' | 'projects' | 'blog' | null;
  /** Background noise field: 'bold' for the home page, 'quiet' for reading pages. */
  background?: 'bold' | 'quiet';
}

const {
  title = 'Jason Paladini',
  description = 'Jason Paladini — Data Engineer',
  active = null,
  background = 'quiet',
} = Astro.props;

const navLinks = [
  { href: '/projects', label: 'Work', key: 'projects' },
  { href: '/blog', label: 'Writing', key: 'blog' },
  { href: '/jason-paladini-resume.pdf', label: 'Résumé', key: 'resume', external: true },
  { href: '/#contact', label: 'Contact', key: 'contact' },
];

const backgrounds = {
  bold: { intensity: 0.6, speed: 1 },
  quiet: { intensity: 0.35, speed: 0.45 },
};

const eyebrow = 'uppercase tracking-eyebrow';
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="icon" type="image/png" href="/jp_black.png" />
    <link rel="canonical" href={`https://jpaladini.com${Astro.url.pathname}`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Jason Paladini",
      "jobTitle": "Data Engineer",
      "url": "https://jpaladini.com",
      "sameAs": [
        "https://github.com/jpaladini",
        "https://linkedin.com/in/jason-paladini"
      ]
    })} />

    <Analytics />
  </head>

  <body class="bg-bg text-text font-mono text-sm leading-[1.6] antialiased overflow-x-hidden">
    <DitherBackground {...backgrounds[background]} />

    <div class="relative z-[1] min-h-screen flex flex-col">
      <header>
        <div class="box-content max-w-content mx-auto px-6 py-[21px] flex flex-wrap justify-between items-center gap-x-4 gap-y-1">
          <a
            href="/"
            class={`flex items-center gap-3 min-h-[44px] no-underline text-[13px] ${eyebrow}`}
            aria-current={active === 'home' ? 'page' : undefined}
          >
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M11 2 L19 11 L11 20 L3 11 Z"></path>
              <path d="M11 7 L11 15"></path>
            </svg>
            <span>Jason Paladini</span>
          </a>
          <nav aria-label="Main" class={`flex flex-wrap gap-x-7 text-[13px] ${eyebrow}`}>
            {navLinks.map((link) => (
              <a
                href={link.href}
                class="inline-flex items-center min-h-[44px] no-underline"
                aria-current={active === link.key ? 'page' : undefined}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener' : undefined}
              >
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      </header>

      <main class="flex-1">
        <div class="box-content max-w-article mx-auto px-6 pt-14 pb-24">
          <slot />
        </div>
      </main>

      <footer>
        <div class={`box-content max-w-content mx-auto px-6 pt-8 pb-10 flex flex-wrap justify-between gap-3 text-xs text-text-muted ${eyebrow}`}>
          <span>Paladini · Built in NJ</span>
          <span>© {new Date().getFullYear()}</span>
        </div>
      </footer>
    </div>

    <style is:global>
      /* Base link treatment. `body a` outranks Tailwind's preflight reset
         whatever order the stylesheets load in; utilities still override it. */
      body a {
        color: #ececec;
        text-decoration: underline;
        text-decoration-color: #5a5a5a;
        text-underline-offset: 3px;
      }
      body a:hover {
        color: #ffffff;
        text-decoration-color: #ececec;
      }

      :focus-visible {
        outline: 1px solid #ececec;
        outline-offset: 3px;
      }
    </style>
  </body>
</html>
