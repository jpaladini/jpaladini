---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="404 · Page Not Found" description="This page doesn't exist.">
  <dl class="grid grid-cols-[88px_minmax(0,1fr)] gap-x-4 gap-y-0.5 m-0 mb-7 text-[13px]">
    <dt class="text-text-muted">Status:</dt>
    <dd class="m-0">404</dd>
  </dl>
  <hr class="m-0 mb-12 border-0 border-t border-dashed border-rule-dashed" />

  <h1 class="m-0 mb-7 font-serif font-normal text-[clamp(36px,9vw,46px)] leading-[1.12] tracking-[-0.01em] text-text-bright">Page not found</h1>
  <p class="m-0 mb-5 font-serif text-[20px] leading-[1.6]">This page doesn't exist or may have moved.</p>
  <p class="m-0 text-[13px]"><a href="/">← Back home</a></p>
</MainLayout>
