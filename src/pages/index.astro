---
import MainLayout from '../layouts/MainLayout.astro';
import { getPosts } from '../lib/blog';

const facts = [
  { label: 'Name', value: 'Jason Paladini' },
  { label: 'Role', value: 'Data Engineer, Horizon BCBSNJ' },
  { label: 'Where', value: 'New Jersey' },
  { label: 'Status', value: 'Available for work' },
];

const architecture = [
  { layer: 'bronze', stage: 'raw capture', detail: 'recordings + metadata, landed as-is' },
  { layer: 'silver', stage: 'transcribe + analyze', detail: 'transcription, LLM analysis, embeddings' },
  { layer: 'gold', stage: 'serving tables', detail: 'curated, governed, query-ready' },
  { layer: 'rag', stage: 'cited answers', detail: 'dual-index retrieval + vector search' },
];

// Fixed-width columns, one layer per line, joined by a down arrow.
const architectureDiagram = architecture
  .map((a) => `${a.layer.padEnd(9)}${a.stage.padEnd(21)}${a.detail}`)
  .join('\n   ↓\n');

const projects = [
  {
    title: 'Power BI vs Snowflake',
    tags: ['Streamlit', 'Snowflake'],
    url: 'https://jphzn-pbi-snwflk-compare-20260125.streamlit.app/',
  },
  {
    title: 'Model Explorer',
    tags: ['dbt', 'Power BI'],
    url: 'https://jp-pbi-model-explorer.streamlit.app/',
  },
  {
    title: 'Data Profiling Tool',
    tags: ['Python', 'data quality'],
    url: 'https://jphzn-profiling.streamlit.app/',
  },
  {
    title: 'Claims Timeliness',
    tags: ['BI', 'healthcare'],
    url: 'https://jp-claims-timeliness.streamlit.app/',
  },
];

const experience = [
  { period: '2017 — now', role: 'Data Engineer · Horizon BCBSNJ' },
  { period: '2012 — 2016', role: 'Stony Brook University' },
  { period: '2004 — 2009', role: 'Corporal · U.S. Marine Corps' },
];

// Two most recent posts for the "Writing" teasers.
const posts = (await getPosts()).slice(0, 2);

const sectionHead = 'flex justify-between items-baseline gap-4 mb-4';
const sectionTitle = 'm-0 font-serif font-semibold text-[28px] text-text-bright';
const rowTitle = 'decoration-text underline-offset-[3px] group-hover:underline';
---

<MainLayout
  title="Jason Paladini — Data Engineer"
  description="Jason Paladini builds data platforms and the production GenAI that runs on them — Databricks, Snowflake, Fabric."
  active="home"
  background="bold"
>
  <dl class="grid grid-cols-[88px_minmax(0,1fr)] gap-x-4 gap-y-0.5 m-0 mb-7 text-[13px]">
    {facts.map((f) => (
      <>
        <dt class="text-text-muted">{f.label}:</dt>
        <dd class="m-0">{f.value}</dd>
      </>
    ))}
  </dl>
  <hr class="m-0 mb-12 border-0 border-t border-dashed border-rule-dashed" />

  <h1 class="m-0 mb-7 font-serif font-normal text-[clamp(36px,9vw,46px)] leading-[1.12] tracking-[-0.01em] text-text-bright">
    Data platforms, and the AI that runs on them.
  </h1>
  <p class="m-0 mb-5 font-serif text-[20px] leading-[1.6]">
    I build data platforms on Databricks, Snowflake and Fabric, and the RAG systems that run on top of them.
  </p>
  <p class="m-0 mb-24 text-[13px]"><a href="#work">See the work →</a></p>

  <!-- Featured case study -->
  <section id="work" class="mb-20">
    <p class="m-0 mb-2 text-[12px] uppercase tracking-eyebrow text-text-muted">Featured · 01 · Horizon BCBSNJ</p>
    <h2 class={`${sectionTitle} mb-4 leading-[1.25]`}>Call Intelligence Lakehouse</h2>
    <p class="m-0 mb-4 font-serif text-[19px] leading-[1.6]">
      Customer-service calls, transcribed, analyzed and searchable with cited answers.
    </p>
    <pre aria-label="Architecture" class="m-0 mb-5 py-5 border-y border-rule font-mono text-[13px] leading-[1.85] text-text-code whitespace-pre overflow-x-auto">{architectureDiagram}</pre>
    <p class="m-0 text-[13px]"><a href="/blog/call-intelligence-lakehouse">Read the write-up →</a></p>
  </section>

  <!-- Selected projects -->
  <section id="projects" class="mb-20">
    <div class={sectionHead}>
      <h2 class={sectionTitle}>Selected projects</h2>
      <a href="/projects" class="text-[13px]">All 6 →</a>
    </div>
    <ol class="list-none m-0 p-0 border-t border-rule">
      {projects.map((p, i) => (
        <li class="border-b border-rule">
          <a href={p.url} target="_blank" rel="noopener" class="group grid grid-cols-[36px_minmax(0,1fr)] gap-3 py-4 no-underline">
            <span class="text-[13px] text-text-muted">{String(i + 1).padStart(2, '0')}</span>
            <span class="flex flex-col gap-1">
              <span class={`font-serif text-[20px] text-text-bright ${rowTitle}`}>{p.title}</span>
              <span class="text-[12px] text-text-muted">{p.tags.join(' · ')}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- Experience -->
  <section id="resume" class="mb-20">
    <div class={sectionHead}>
      <h2 class={sectionTitle}>Experience</h2>
      <a href="/jason-paladini-resume.pdf" target="_blank" rel="noopener" class="text-[13px]">Résumé (PDF) →</a>
    </div>
    <ul class="list-none m-0 p-0 border-t border-rule text-[13px]">
      {experience.map((e) => (
        <li class="grid grid-cols-[120px_minmax(0,1fr)] gap-4 py-3 border-b border-rule">
          <span class="text-text-muted">{e.period}</span>
          <span>{e.role}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Writing -->
  {posts.length > 0 && (
    <section id="writing" class="mb-20">
      <div class={sectionHead}>
        <h2 class={sectionTitle}>Writing</h2>
        <a href="/blog" class="text-[13px]">All posts →</a>
      </div>
      <div class="border-t border-rule">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="group block py-[18px] border-b border-rule no-underline">
            <span class="block mb-1.5 text-[12px] text-text-muted">{post.data.category} · {post.data.readingTime}</span>
            <span class={`block font-serif text-[21px] leading-[1.35] text-text-bright ${rowTitle}`}>{post.data.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Contact -->
  <section id="contact">
    <h2 class="m-0 mb-4 font-serif font-normal italic text-[34px] leading-[1.2] text-text-bright">Let’s build something reliable.</h2>
    <p class="m-0 flex flex-wrap gap-x-6 text-[13px]">
      <a href="mailto:jason@jpaladini.com" class="py-3 -my-3">jason@jpaladini.com</a>
      <a href="https://github.com/jpaladini" target="_blank" rel="noopener" class="py-3 -my-3">GitHub</a>
      <a href="https://linkedin.com/in/jason-paladini" target="_blank" rel="noopener" class="py-3 -my-3">LinkedIn</a>
    </p>
  </section>
</MainLayout>
