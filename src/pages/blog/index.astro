---
import MainLayout from '../../layouts/MainLayout.astro';
import { getPosts } from '../../lib/blog';

const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

const posts = await getPosts();
---

<MainLayout
  title="Blog — Jason Paladini"
  description="Notes and write-ups on shipping data platforms and production GenAI in a regulated, enterprise setting."
  active="blog"
>
  <dl class="grid grid-cols-[88px_minmax(0,1fr)] gap-x-4 gap-y-0.5 m-0 mb-7 text-[13px]">
    <dt class="text-text-muted">Index:</dt>
    <dd class="m-0">Writing</dd>
    <dt class="text-text-muted">Posts:</dt>
    <dd class="m-0">{posts.length}</dd>
  </dl>
  <hr class="m-0 mb-12 border-0 border-t border-dashed border-rule-dashed" />

  <h1 class="m-0 mb-7 font-serif font-normal text-[clamp(36px,9vw,46px)] leading-[1.12] tracking-[-0.01em] text-text-bright">Notes &amp; write-ups</h1>
  <p class="m-0 mb-16 font-serif text-[20px] leading-[1.6]">
    Things I've learned shipping data platforms and production GenAI in a regulated, enterprise setting. Mostly practical, occasionally opinionated.
  </p>

  <div class="border-t border-rule">
    {posts.map((post) => (
      <a href={`/blog/${post.id}`} class="group block py-[18px] border-b border-rule no-underline">
        <span class="block mb-1.5 text-[12px] text-text-muted">
          {monthFmt.format(post.data.date)} · {post.data.part ? `${post.data.series} · Part ${post.data.part}` : post.data.category} · {post.data.readingTime}
          {post.data.featured && <span> · Featured</span>}
          {post.data.draft && <span class="text-text"> · Draft</span>}
        </span>
        <span class="block font-serif text-[21px] leading-[1.35] text-text-bright decoration-text underline-offset-[3px] group-hover:underline">{post.data.title}</span>
      </a>
    ))}
  </div>
</MainLayout>
