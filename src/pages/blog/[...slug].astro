---
import MainLayout from '../../layouts/MainLayout.astro';
import { render } from 'astro:content';
import { getPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' });

// Subject line: the title up to its first colon or dash clause.
const subject = post.data.title.split(/:\s|\s[—–]\s/)[0];

const all = await getPosts();

// Posts in the same series, ordered by part number.
const seriesPosts = post.data.series
  ? all
      .filter((p) => p.data.series === post.data.series)
      .sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
  : [];
const seriesIndex = seriesPosts.findIndex((p) => p.id === post.id);
const nextPart = seriesIndex >= 0 && seriesIndex < seriesPosts.length - 1 ? seriesPosts[seriesIndex + 1] : null;

// Pick a related post: next in series, else the most recent other post.
const others = all.filter((p) => p.id !== post.id && p.data.series !== post.data.series);
const related = nextPart ?? others[0] ?? null;

const eyebrow = 'm-0 mb-2 text-[12px] uppercase tracking-eyebrow text-text-muted';
const rowTitle = 'decoration-text underline-offset-[3px] group-hover:underline';
const partRow = 'grid grid-cols-[36px_minmax(0,1fr)] gap-3 py-3';
const partTitle = 'font-serif text-[19px] leading-[1.35] text-text-bright';
---

<MainLayout
  title={`${post.data.title} — Jason Paladini`}
  description={post.data.description}
  active="blog"
>
  <article>
    <dl class="grid grid-cols-[88px_minmax(0,1fr)] gap-x-4 gap-y-0.5 m-0 mb-7 text-[13px]">
      <dt class="text-text-muted">Date:</dt>
      <dd class="m-0"><time datetime={post.data.date.toISOString()}>{dateFmt.format(post.data.date)}</time></dd>
      <dt class="text-text-muted">From:</dt>
      <dd class="m-0">{post.data.author} &lt;<a href="mailto:jason@jpaladini.com">jason@jpaladini.com</a>&gt;</dd>
      <dt class="text-text-muted">Filed:</dt>
      <dd class="m-0">{post.data.category} · {post.data.readingTime}</dd>
      {post.data.series && (
        <>
          <dt class="text-text-muted">Series:</dt>
          <dd class="m-0">{post.data.series} · Part {post.data.part}</dd>
        </>
      )}
      {post.data.draft && (
        <>
          <dt class="text-text-muted">Status:</dt>
          <dd class="m-0">Draft — hidden in production</dd>
        </>
      )}
      <dt class="text-text-muted">Subject:</dt>
      <dd class="m-0 font-medium">{subject}</dd>
    </dl>
    <hr class="m-0 mb-12 border-0 border-t border-dashed border-rule-dashed" />

    <h1 class="m-0 mb-6 font-serif font-normal text-[clamp(30px,7.4vw,42px)] leading-[1.15] tracking-[-0.01em] text-text-bright">{post.data.title}</h1>

    <div class="post-body">
      <p class="italic text-text-soft">{post.data.description}</p>
      <Content />
    </div>

    {post.data.tags.length > 0 && (
      <p class="m-0 mt-10 text-[12px] text-text-muted">Tagged: {post.data.tags.join(' · ')}</p>
    )}
  </article>

  {seriesPosts.length > 1 && (
    <section class="mt-14">
      <h2 class={eyebrow}>Series · {post.data.series} · {seriesPosts.length} parts</h2>
      <ol class="list-none m-0 p-0 border-t border-rule">
        {seriesPosts.map((p) => (
          <li class="border-b border-rule">
            {p.id === post.id ? (
              <span class={partRow} aria-current="page">
                <span class="text-[13px] text-text-muted">{String(p.data.part ?? 0).padStart(2, '0')}</span>
                <span class={partTitle}>{p.data.title} <span class="font-mono text-[12px] text-text-muted whitespace-nowrap">(this post)</span></span>
              </span>
            ) : (
              <a href={`/blog/${p.id}`} class={`group no-underline ${partRow}`}>
                <span class="text-[13px] text-text-muted">{String(p.data.part ?? 0).padStart(2, '0')}</span>
                <span class={`${partTitle} ${rowTitle}`}>{p.data.title}</span>
              </a>
            )}
          </li>
        ))}
      </ol>
    </section>
  )}

  {related && (
    <section class="mt-14">
      <h2 class={eyebrow}>{nextPart ? 'Next in series' : 'Related'}</h2>
      <div class="border-t border-rule">
        <a href={`/blog/${related.id}`} class="group block py-[18px] border-b border-rule no-underline">
          <span class="block mb-1.5 text-[12px] text-text-muted">{related.data.category} · {related.data.readingTime}</span>
          <span class={`block font-serif text-[21px] leading-[1.35] text-text-bright ${rowTitle}`}>{related.data.title}</span>
        </a>
      </div>
    </section>
  )}

  <hr class="m-0 mt-14 mb-6 border-0 border-t border-dashed border-rule-dashed" />
  <p class="m-0 flex flex-wrap justify-between gap-4 text-[13px]">
    <a href="/blog">← All writing</a>
    <span class="text-text-muted">Reply: <a href="mailto:jason@jpaladini.com">jason@jpaladini.com</a></span>
  </p>
</MainLayout>

<!-- Render mermaid code fences (converted to <pre class="mermaid"> at build time) as diagrams. -->
<script>
  import mermaid from 'mermaid';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'dark',
    securityLevel: 'strict',
    fontFamily: '"IBM Plex Mono", ui-monospace, monospace',
    themeVariables: {
      background: '#1a1a1a',
      primaryColor: '#262626',
      mainBkg: '#262626',
      primaryTextColor: '#ececec',
      primaryBorderColor: '#5a5a5a',
      nodeBorder: '#5a5a5a',
      lineColor: '#9b9b9b',
      textColor: '#ececec',
      edgeLabelBackground: '#1a1a1a',
      fontFamily: '"IBM Plex Mono", monospace',
    },
  });

  const nodes = document.querySelectorAll('.mermaid');
  if (nodes.length) {
    mermaid.run({ nodes: Array.from(nodes) as HTMLElement[] });
  }
</script>

<style is:global>
  /* Long-form prose rendered from markdown, scoped to .post-body: serif body
     on the article measure, mono for anything code-like or tabular. */
  .post-body {
    font-family: Newsreader, Georgia, serif;
    font-size: 19px;
    line-height: 1.65;
    /* Long URLs and inline code break rather than widen the page. */
    overflow-wrap: break-word;

    /* Shiki's css-variables theme: one dimmed tone, comments quieter still. */
    --astro-code-foreground: rgba(240, 240, 240, 0.82);
    --astro-code-background: transparent;
    --astro-code-token-comment: #9b9b9b;
  }

  .post-body > * {
    margin: 0;
  }
  .post-body > * + * {
    margin-top: 20px;
  }

  .post-body h2 {
    margin-top: 40px;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.3;
    color: #ffffff;
  }

  .post-body h3 {
    margin-top: 32px;
    font-size: 21px;
    font-weight: 600;
    line-height: 1.35;
    color: #ffffff;
  }

  .post-body ul,
  .post-body ol {
    padding-left: 24px;
  }
  .post-body ul { list-style: disc; }
  .post-body ol { list-style: decimal; }
  .post-body li + li,
  .post-body li > ul,
  .post-body li > ol {
    margin-top: 8px;
  }
  .post-body li::marker { color: #9b9b9b; }

  .post-body strong {
    font-weight: 600;
    color: #ffffff;
  }
  .post-body em { font-style: italic; }

  /* Pull-quote (markdown blockquote): indented italic, no box. */
  .post-body blockquote {
    padding-left: 24px;
    font-style: italic;
    color: #d6d6d6;
  }
  .post-body blockquote > * + * {
    margin-top: 12px;
  }

  /* Inline code chip */
  .post-body :not(pre) > code {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 15px;
    font-style: normal;
    background: #262626;
    padding: 1px 5px;
    border-radius: 3px;
  }

  /* Code blocks: no box, just hairlines and dimmed mono. */
  .post-body pre {
    margin: 28px 0;
    padding: 20px 0;
    border-top: 1px solid #333333;
    border-bottom: 1px solid #333333;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 13px;
    line-height: 1.85;
    color: rgba(240, 240, 240, 0.82);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .post-body pre code {
    font-family: inherit;
  }

  /* Mermaid diagrams render to SVG; drop the code-block rules. */
  .post-body pre.mermaid {
    padding: 0;
    border: 0;
    text-align: center;
  }

  /* Tables: tabular data sits in mono, ruled with hairlines. */
  .post-body table {
    width: 100%;
    margin: 28px 0;
    border-collapse: collapse;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 13px;
    line-height: 1.6;
  }
  .post-body th,
  .post-body td {
    text-align: left;
    padding: 10px 16px 10px 0;
    border-bottom: 1px solid #333333;
    vertical-align: top;
  }
  .post-body th:last-child,
  .post-body td:last-child {
    padding-right: 0;
  }
  .post-body th {
    border-top: 1px solid #333333;
    font-weight: 400;
    color: #9b9b9b;
  }
  .post-body td code {
    font-size: 12px;
  }
  @media (max-width: 640px) {
    .post-body table {
      display: block;
      overflow-x: auto;
    }
  }

  /* Horizontal rule */
  .post-body hr {
    margin: 40px 0;
    border: 0;
    border-top: 1px dashed #3a3a3a;
  }

  /* Post images (screenshots) */
  .post-body img {
    display: block;
    max-width: 100%;
    margin: 8px auto 0;
    border: 1px solid #333333;
    border-radius: 3px;
  }

  /* Collapsed text alternative for a rendered diagram */
  .post-body details.diagram-note summary {
    cursor: pointer;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 12px;
    color: #9b9b9b;
  }
  .post-body details.diagram-note p {
    margin: 10px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: #d6d6d6;
  }
</style>
